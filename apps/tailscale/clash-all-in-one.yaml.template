# Clash Verge Rev 配置模板（Sing-box HTTP/TLS + Hysteria2）
# 本文件为占位模板，可提交到 Git。使用步骤见同目录说明文档 sing-box-Hysteria2-config.md。
# 占位符全部替换后的成品请另存为：{VPS 公网 IPv4}_clash-all-in-one.yaml（勿提交 Git，参见仓库 .gitignore）。
#
# 占位符一览（建议另存为 {VPS 公网 IPv4}_clash-all-in-one.yaml 后在编辑器里全局替换）：
#   YOUR_SERVER_DOMAIN      — 与证书一致的域名（与 proxies 里 server 相同）
#   YOUR_SINGBOX_USERNAME   — sing-box mixed 入站用户名
#   YOUR_SINGBOX_PASSWORD   — sing-box mixed 入站密码
#   YOUR_HYSTERIA2_PASSWORD — Hysteria2 auth 密码
#   （可选）在 rules「自身服务器直连」处取消 IP-CIDR 注释并填写公网 IP
#
mode: rule
sniffer:
  enable: true
  force-dns-mapping: true
  parse-pure-ip: true
  override-destination: true
  sniff:
    HTTP:
      ports:
        - 80
        - 8080-8880
    TLS:
      ports:
        - 443
        - 8443

# 代理节点配置
proxies:
  # HTTP/SOCKS5 代理 (Sing-box)
  - name: "singbox-http"
    type: http
    server: YOUR_SERVER_DOMAIN
    port: 2080
    username: YOUR_SINGBOX_USERNAME
    password: "YOUR_SINGBOX_PASSWORD"
    tls: true
    skip-cert-verify: false

  # Hysteria2 代理 (高速 UDP)
  - name: "hysteria2-udp"
    type: hysteria2
    server: YOUR_SERVER_DOMAIN
    port: 8443
    password: YOUR_HYSTERIA2_PASSWORD
    skip-cert-verify: false

# 代理组配置
proxy-groups:
  # 主代理组 - 自动选择最快节点
  - name: "🚀 代理节点"
    type: url-test
    proxies:
      - singbox-http
      - hysteria2-udp
    url: "http://www.gstatic.com/generate_204"
    interval: 300
    tolerance: 50

  # 手动选择组
  - name: "📋 手动选择"
    type: select
    proxies:
      - singbox-http
      - hysteria2-udp
      - DIRECT

  # HTTP/SOCKS5 专用组
  - name: "📡 HTTP代理"
    type: select
    proxies:
      - singbox-http
      - DIRECT

  # Hysteria2 专用组（适合开发工具）
  - name: "⚡ 高速代理"
    type: select
    proxies:
      - hysteria2-udp
      - DIRECT

# 分流规则（自上而下首条命中生效）
rules:
  # --- 局域网 / 本机 / 防代理环路 ---
  - DOMAIN,injections.adguard.org,DIRECT
  - DOMAIN,local.adguard.org,DIRECT
  - DOMAIN-SUFFIX,local,DIRECT

  # --- 自身服务器直连（不走代理，防环路）；与 proxies 中 server 一致 ---
  - DOMAIN,YOUR_SERVER_DOMAIN,DIRECT
